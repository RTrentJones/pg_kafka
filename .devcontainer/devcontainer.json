{
  "name": "pg_kafka Development Container",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "pg_kafka_dev",
  "workspaceFolder": "/home/postgres/workspace",
  // Run as the postgres user (non-root)
  "remoteUser": "postgres",
  // Features to install in the container
  "features": {
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableNonRootDocker": "true",
      "moby": "true"
    }
  },
  // VS Code extensions to install
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "serayuzgur.crates",
        "tamasfe.even-better-toml",
        "usernamehw.errorlens",
        "ms-vscode.makefile-tools"
      ],
      "settings": {
        "rust-analyzer.cargo.features": [
          "pg14"
        ],
        "rust-analyzer.checkOnSave.command": "clippy",
        "rust-analyzer.checkOnSave.allTargets": false,
        "rust-analyzer.check.extraArgs": [
          "--features",
          "pg14"
        ],
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.watcherExclude": {
          "**/target/**": true
        }
      }
    }
  },
  // Ports to forward
  // pgrx runs PostgreSQL 14 on 28814; pg_kafka listens on 127.0.0.1:9092 inside the
  // container, which VS Code's forwarding reaches (it tunnels to the container's localhost).
  "forwardPorts": [
    28814,
    9092
  ],
  "portsAttributes": {
    "28814": {
      "label": "PostgreSQL (pgrx pg14)",
      "onAutoForward": "notify"
    },
    "9092": {
      "label": "Kafka Protocol",
      "onAutoForward": "notify"
    }
  },
  // No post-create command: the image (Dockerfile.dev) has the toolchain and rustup picks the
  // pinned one from rust-toolchain.toml. RUSTUP_PERMIT_COPY_RENAME lets rustup install across
  // the bind mount's device boundary.
  "containerEnv": {
    "RUST_LOG": "info",
    "RUSTUP_PERMIT_COPY_RENAME": "true"
  }
}