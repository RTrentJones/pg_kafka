#!/usr/bin/env bash
# pg_kafka pre-push hook: the lint pass CI enforces, once per push instead of on every commit.
#
# Install with ./hooks/install.sh.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "🔍 cargo clippy (root, --all-targets, pg14)..."
if ! cargo clippy --all-targets --features pg14 -- -D warnings; then
  echo "❌ Clippy check failed." >&2
  exit 1
fi
echo "🔍 cargo clippy (kafka_test, --all-targets)..."
if ! (cd kafka_test && cargo clippy --all-targets -- -D warnings); then
  echo "❌ kafka_test clippy check failed." >&2
  exit 1
fi
echo "✅ Pre-push checks passed"
