#!/usr/bin/env bash
# pg_kafka pre-commit hook: the fast checks only (formatting of both crates, seconds).
# Clippy takes minutes, so it runs in pre-push: a slow pre-commit hook trains contributors to
# reach for --no-verify, which skips everything.
#
# Install with ./hooks/install.sh.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "🔍 cargo fmt --check (root, kafka_test)..."
if ! cargo fmt --check; then
  echo "❌ Formatting check failed: run 'cargo fmt'." >&2
  exit 1
fi
if ! (cd kafka_test && cargo fmt --check); then
  echo "❌ kafka_test formatting check failed: run 'cd kafka_test && cargo fmt'." >&2
  exit 1
fi
echo "✅ Formatting checks passed (clippy runs on pre-push)"
